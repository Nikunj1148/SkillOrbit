# SkillOrbit Environment Configuration
# Copy this file to .env and update values as needed

# Database (SQLite for local demo, change to postgresql:// for production)
DATABASE_URL=sqlite+aiosqlite:///./data/skillorbit.db

# Session secret key (generate a random one for production!)
SESSION_SECRET=change-me-to-a-random-secret-in-production

# Server
HOST=127.0.0.1
PORT=8000

# CORS origin (frontend dev server)
CORS_ORIGIN=http://localhost:5173

# AI Provider (demo|live) — live requires additional config
AI_PROVIDER=demo

# Future: Live AI configuration (disabled in demo)
# OPENAI_API_KEY=
# AI_RATE_LIMIT_PER_MINUTE=10
# AI_SPENDING_LIMIT_USD=0
